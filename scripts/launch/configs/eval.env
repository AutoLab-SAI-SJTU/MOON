# Settings of the evaluation arms that are not defaults of scripts/run_harness_eval.py.

# Query interval: thresholds for a judge queried every k-th decision point on R2R, matched to the alarm
# count of k = 1 (k = 1 uses the calibrated tau of ALPHA).
QUERY_INTERVAL_TAU_2=2.08
QUERY_INTERVAL_TAU_4=1.00
# pass@k of sampled restarts: draw k uses --seed-base SEED_BASE + DRAW_SEED_STRIDE * k.
SEED_BASE=41
DRAW_SEED_STRIDE=1000
# Latency: episodes timed with one process per GPU, so per-call timings carry no contention.
TIMING_EPISODES=80

